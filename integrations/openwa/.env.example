# Store the real values in your private host/secret manager. Never commit .env.
OPENWA_SESSION_ID=family-power-demo
OPENWA_WEBHOOK_URL=https://YOUR-PROJECT.supabase.co/functions/v1/openwa-whatsapp-inbound
OPENWA_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
OPENWA_API_KEY=REPLACE_WITH_OTHER_LONG_RANDOM_SECRET
# Generate a 32-byte key in Base64, e.g. openssl rand -base64 32
OPENWA_SESSION_DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
