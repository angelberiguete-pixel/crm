# Set these in the host's secret store; never submit filled values to Git/chat.
NEXTAUTH_URL=https://YOUR_VERIFIED_OPENREPLY_HOST
NEXTAUTH_SECRET=GENERATE_A_RANDOM_SECRET
CRON_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET
ENCRYPTION_KEY=GENERATE_64_RANDOM_HEXADECIMAL_CHARACTERS
DATABASE_URL=postgresql://openreply:URL_ENCODED_DEDICATED_PASSWORD@postgres:5432/openreply
REDIS_URL=redis://:URL_ENCODED_DEDICATED_PASSWORD@redis:6379
ALLOWED_EMAILS=YOUR_AUTHORIZED_OWNER_EMAIL
EMAIL_SERVER=YOUR_AUTHORIZED_SMTP_URL
EMAIL_FROM=YOUR_VERIFIED_SENDER
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=YOUR_EXISTING_META_APP_ID
INSTAGRAM_APP_SECRET=SET_ONLY_IN_THE_SECRET_STORE
FACEBOOK_APP_SECRET=SET_ONLY_IN_THE_SECRET_STORE_IF_NEEDED
WEBHOOK_VERIFY_TOKEN=GENERATE_A_DIFFERENT_RANDOM_SECRET
CRM_WEBHOOK_URL=https://ygipjqgyreeahslzorik.supabase.co/functions/v1/openreply-crm-events
# Enable only after the account route has been verified in the CRM.
# Each record: keyId,secret,workspaceId,instagramAccountId,since (UTC ISO time).
# The receiver key store uses the same records without the since property.
CRM_BRIDGE_BINDINGS_JSON=[]
